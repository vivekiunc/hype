# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=hype_arbitrage

# API Configuration (optional - uses public endpoints by default)
HYPERLIQUID_API_KEY=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Simulation Parameters
RETAIL_SPREAD_BPS=10
ARBITRAGE_THRESHOLD_BPS=5
HFT_REACTION_TIME_MS=100

# Data Collection
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT
HYPERLIQUID_COINS=BTC,ETH

# Logging
LOG_LEVEL=INFO
